ck;font-size:15px;font-weight:700;color:var(--orange)}\nthead th.featured{background:var(--orange);color:#fff}\nthead th.featured .plan-price{color:#fff}\nthead th .badge{display:inline-block;font-size:10px;letter-spacing:1px;border:1px solid currentColor;padding:1px 6px;margin-bottom:6px}\ntbody th{text-align:left;font-weight:500;color:var(--gray);padding:13px 18px;border-bottom:1px solid #e4e4df;white-space:nowrap;background:var(--paper)}\ntbody td{padding:13px 18px;border-bottom:1px solid #e4e4df;border-left:1px solid #e4e4df;vertical-align:top}\ntbody tr:last-child th,tbody tr:last-child td{border-bottom:none}\ntbody td.yes{color:var(--ink)}\ntbody td.no{color:#b3b3ad}\n.table-note{font-size:13px;color:var(--gray);margin:14px 0 0}\n\n/* 使用说明步骤 */\n.steps{counter-reset:step;display:grid;gap:0;border:2px solid var(--line)}\n.step{display:grid;grid-template-columns:76px 1fr;border-bottom:2px solid var(--line)}\n.step:last-child{border-bottom:none}\n.step .idx{display:flex;align-items:flex-start;justify-content:center;padding-top:20px;font-size:26px;font-weight:800;letter-spacing:-1px;color:var(--orange);border-right:2px solid var(--line)}\n.step .body{padding:20px 22px 24px}\n.step .body p{margin:0;font-size:15px;color:#333}\n\n/* 客户端 */\n.client-list{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}\n.client{border:2px solid var(--line);padding:20px}\n.client h3{margin-bottom:6px}\n.client .status{display:inline-block;font-size:11px;letter-spacing:1px;border:1px solid var(--line);padding:2px 8px;margin-bottom:12px}\n.client p{font-size:14px;color:#333;margin:0 0 12px}\n.client .link{font-size:14px;font-weight:700;border-bottom:2px solid var(--orange)}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;gap:0 40px;grid-template-columns:1fr 1fr}\n.faq-grid .qa{padding:20px 0;border-top:2px solid var(--line)}\n.faq-grid .qa h3{font-size:16px;line-height:1.5;margin-bottom:8px}\n.faq-grid .qa h3::before{content:\"Q \";color:var(--orange);font-weight:800}\n.faq-grid .qa p{margin:0;font-size:14px;color:#333}\n.faq-grid .qa p::before{content:\"A \";color:var(--gray);font-weight:700}\n\n/* 收尾 */\n.foot{border-top:2px solid var(--line);padding:34px 0 60px;display:flex;flex-wrap:wrap;gap:16px 40px;justify-content:space-between;align-items:flex-end}\n.foot .big{font-size:clamp(28px,5vw,54px);font-weight:800;letter-spacing:-0.04em;line-height:1}\n.foot .big span{color:var(--orange)}\n.foot .meta{font-size:12px;color:var(--gray);line-height:1.9}\n\n@media (max-width:860px){\n  .shell{display:block}\n  .sidenav{position:static;border-right:none;border-bottom:2px solid var(--line);padding:20px 0 6px;margin-bottom:8px}\n  .sidenav .sub{margin-bottom:14px}\n  .sidenav ol{display:flex;flex-wrap:wrap;gap:0 14px}\n  .sidenav ol a{border-bottom:none;padding:4px 0;font-size:13px}\n  .faq-grid{grid-template-columns:1fr}\n  .hero h1{line-height:0.9}\n}\n@media (max-width:520px){\n  .step{grid-template-columns:48px 1fr}\n  .step .idx{font-size:18px;padding-top:22px}\n  .hero{padding:30px 0 28px}\n}\n</style><div class=\"page\">\n  <div class=\"shell\">\n    <nav class=\"sidenav\" aria-label=\"页面目录\">\n      <span class=\"mark\">acce<span>ca</span></span>\n      <span class=\"sub\">Contents</span>\n      <ol>\n        <li><a href=\"#about\"><b>01</b>这是什么</a></li>\n        <li><a href=\"#how\"><b>02</b>怎么用</a></li>\n        <li><a href=\"#plans\"><b>03</b>方案对比</a></li>\n        <li><a href=\"#clients\"><b>04</b>客户端</a></li>\n        <li><a href=\"#faq\"><b>05</b>常见问题</a></li>\n      </ol>\n    </nav>\n\n    <div class=\"content\">\n      <main>\n        <header class=\"hero\">\n          <span class=\"kicker\">网络工具 · 订阅说明</span>\n          <h1>accecca<span class=\"dot\">.</span></h1>\n          <div class=\"lede\">\n            <p>你好，这里是 accecca。我们把订阅内容、价格和使用办法都摊在这一页上，你慢慢看，不用先注册也不用先打招呼。</p>\n            <span class=\"tag\">From us, plainly</span>\n          </div>\n        </header>\n\n        <div class=\"hero-strip\">\n          <div><strong>三档方案</strong><span>按月或按年，随你</span></div>\n          <div><strong>设备数量</strong><span>3 / 5 / 20 台</span></div>\n          <div><strong>流量额度</strong><span>100GB 起，逐档递增</span></div>\n          <div><strong>常见问题</strong><span>10 组问答，见下方</span></div>\n        </div>\n\n        <section class=\"block\" id=\"about\">\n          <span class=\"h2num\">01 — WHAT THIS IS</span>\n          <h2>先说清楚，你在这页能看到什么</h2>\n          <p class=\"intro\">accecca 提供的是一组按流量和并发设备数区分的订阅方案，配套几个常见的客户端使用方式。这一页不做夸张的承诺，只把能确定的部分写出来：价格、额度、设备上限、方案之间的差别，以及你可能想问的问题。剩下的判断权交给你。</p>\n          <div class=\"grid\">\n            <article class=\"card\">\n              <span class=\"num\">A</span>\n              <h3>价格写在明面上</h3>\n              <p>三档方案都有月付和年付两种付法，年付是一次性付清一整年的价格，页面上两个数字都列出来了。</p>\n            </article>\n            <article class=\"card\">\n              <span class=\"num\">B</span>\n              <h3>差别只有几条</h3>\n              <p>方案之间主要差在流量额度、同时在线设备数，以及节点池和支持的响应层级，没有藏着掖着的隐藏条款。</p>\n            </article>\n            <article class=\"card accent\">\n              <span class=\"num\">C</span>\n              <h3>不懂就问</h3>\n              <p>页面底部有十组问答，覆盖计费、换设备、续费等日常会撞上的情况。如果还缺一条，那说明我们暂时还不知道答案。</p>\n            </article>\n          </div>\n        </section>\n\n        <section class=\"block\" id=\"how\">\n          <span class=\"h2num\">02 — HOW TO START</span>\n          <h2>拿到订阅之后，通常是这样用的</h2>\n          <p class=\"intro\">流程不复杂，四步走完就能开始。下面写的是通用顺序，具体客户端的按钮文字可能略有不同，按你看到的界面走就好。</p>\n          <div class=\"steps\">\n            <div class=\"step\">\n              <div class=\"idx\">1</div>\n              <div class=\"body\">\n                <h3>先挑一个和你使用量匹配的方案</h3>\n                <p>如果你只是自己一台电脑、一部手机，基础版的 100GB 和 3 台设备一般够用；常带着平板、家里还有台盒子，就看旗舰版的 5 台。团队版适合需要多人共用一份订阅的场景。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div class=\"idx\">2</div>\n              <div class=\"body\">\n                <h3>把订阅信息导入客户端</h3>\n                <p>选好客户端后，用订阅链接或导入配置的方式把节点信息填进去，客户端会自己读取并列出可用的线路。这一过程不需要你手动抄写地址。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div class=\"idx\">3</div>\n              <div class=\"body\">\n                <h3>按需选择线路并连接</h3>\n                <p>客户端里会按区域和线路类型分组，普通线路和专线线路的标法不一样。挑一个延迟顺眼的，点连接即可。切线路不需要重新导入。</p>\n              </div>\n            </div>\n            <div class=\"step\">\n              <div class=\"idx\">4</div>\n              <div class=\"body\">\n                <h3>留意剩余流量和在线设备</h3>\n                <p>流量是一个计费周期内累计的，多设备同时在线会占用设备名额。如果某天发现连不上，先看看这两个数是不是已经到顶，再考虑其他原因。</p>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"block\" id=\"plans\">\n          <span class=\"h2num\">03 — PLANS</span>\n          <h2>三档方案摆在一起看</h2>\n          <p class=\"intro\">横向对比最省事：左边是各项指标，上面是三档方案。旗舰版那一列高亮，是因为它处在中间，多数人的使用量落在这一档。</p>\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr>\n                  <th>项目</th>\n                  <th>\n                    <span class=\"plan-name\">基础版</span>\n                    <span class=\"plan-price\">¥15 / 月</span>\n                  </th>\n                  <th class=\"featured\">\n                    <span class=\"badge\">多数人选择</span>\n                    <span class=\"plan-name\">旗舰版</span>\n                    <span class=\"plan-price\">¥35 / 月</span>\n                  </th>\n                  <th>\n                    <span class=\"plan-name\">团队版</span>\n                    <span class=\"plan-price\">¥85 / 月</span>\n                  </th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <th>月付价格</th>\n                  <td class=\"yes\">¥15 / 月</td>\n                  <td class=\"yes\">¥35 / 月</td>\n                  <td class=\"yes\">¥85 / 月</td>\n                </tr>\n                <tr>\n                  <th>年付价格</th>\n                  <td class=\"yes\">¥150 / 年</td>\n                  <td class=\"yes\">¥350 / 年</td>\n                  <td class=\"yes\">¥850 / 年</td>\n                </tr>\n                <tr>\n                  <th>每月流量</th>\n                  <td class=\"yes\">100GB</td>\n                  <td class=\"yes\">300GB</td>\n                  <td class=\"yes\">1000GB</td>\n                </tr>\n                <tr>\n                  <th>同时在线设备</th>\n                  <td class=\"yes\">3 台</td>\n                  <td class=\"yes\">5 台</td>\n                  <td class=\"yes\">20 台</td>\n                </tr>\n                <tr>\n                  <th>流媒体支持</th>\n                  <td class=\"yes\">基础流媒体</td>\n                  <td class=\"yes\">全节点原生流媒体解锁</td>\n                  <td class=\"yes\">全节点原生流媒体解锁</td>\n                </tr>\n                <tr>\n                  <th>线路类型</th>\n                  <td class=\"yes\">普通线路节点池</td>\n                  <td class=\"yes\">含 IPLC 专线游戏加速优化</td>\n                  <td class=\"yes\">VIP 专属高带宽节点</td>\n                </tr>\n                <tr>\n                  <th>支持响应</th>\n                  <td class=\"no\">常规工单</td>\n                  <td class=\"yes\">7×24 优先工单</td>\n                  <td class=\"yes\">专属客户经理</td>\n                </tr>\n                <tr>\n                  <th>定制能力</th>\n                  <td class=\"no\">不提供</td>\n                  <td class=\"no\">不提供</td>\n                  <td class=\"yes\">支持企业定制路由</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n          <p class=\"table-note\">年付价格是整年一次性支付的总价，不是每月折后价。流量按自然计费周期累计，未用完的额度不结转到下一周期。</p>\n        </section>\n\n        <section class=\"block\" id=\"clients\">\n          <span class=\"h2num\">04 — CLIENTS</span>\n          <h2>客户端：用哪个，看你手边有什么</h2>\n          <p class=\"intro\">accecca 的订阅本身不绑定客户端，常见的几类工具都能读取。下面写的是适用场景，具体下载请以客户端自身的官方发布页为准，我们不在这一页挂下载地址。</p>\n          <div class=\"client-list\">\n            <article class=\"client\">\n              <h3>桌面端 · Windows / macOS</h3>\n              <span class=\"status\">常规使用</span>\n              <p>适合每天开着电脑的人。导入订阅后可以常驻托盘，切换线路和查看剩余流量都在同一个窗口里完成。</p>\n              <a class=\"link\" href=\"#\">查看配套说明</a>\n            </article>\n            <article class=\"client\">\n              <h3>移动端 · iOS / Android</h3>\n              <span class=\"status\">日常随身</span>\n              <p>在外面用手机时更顺手。订阅导入通常通过粘贴链接或扫码完成，注意系统可能要求先确认网络配置权限。</p>\n              <a class=\"link\" href=\"#\">查看配套说明</a>\n            </article>\n            <article class=\"client\">\n              <h3>路由器 / 盒子端</h3>\n              <span class=\"status\">多人共用</span>\n              <p>一台设备覆盖全家，适合团队版这类多设备方案。配置一次之后，其他设备无需逐台设置，但仍会占用同时在线名额。</p>\n              <a class=\"link\" href=\"#\">查看配套说明</a>\n            </article>\n          </div>\n        </section>\n\n        <section class=\"block\" id=\"faq\">\n          <span class=\"h2num\">05 — FAQ</span>\n          <h2>你可能想问的，先替你问了</h2>\n          <p class=\"intro\">十组问答，左边五组偏计费和方案，右边五组偏使用和日常操作。有没覆盖到的，记下来问我们。</p>\n          <div class=\"faq-grid\">\n            <div class=\"qa\">\n              <h3>月付和年付，我该怎么选？</h3>\n              <p>先按月付用一两个周期，看看自己实际会用掉多少流量、几台设备真正在连。确认下来之后再换年付，年付是一次性付整年的总额，适合已经确定要长期使用的场景。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>三档方案的主要区别只有流量吗？</h3>\n              <p>不止。除了每月 100GB、300GB、1000GB 的额度差别，同时在线设备数分别是 3 台、5 台、20 台，线路池和支持响应也不同：基础版是普通线路池，旗舰版含 IPLC 专线游戏加速优化，团队版提供 VIP 专属高带宽节点。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>流量用完了会怎样？</h3>\n              <p>本计费周期内的额度用完后，需要等下个周期重置，或者调整到更高一档的方案。额度不跨周期累积，所以选方案时按自己平时的用量留一点余量会更省心。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>同时在线设备是怎么算的？</h3>\n              <p>按同一时间处于连接状态的设备数量计算。手机、电脑、平板各算一台，路由器上如果接了多台设备，通常按路由器本身这一台计，但具体以客户端显示为准。用完一台再连另一台，不会长期占名额。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>团队版的“定制路由”具体指什么？</h3>\n              <p>指的是可以根据团队的访问习惯，对线路走向做针对性配置，适合有固定内网或特定区域需求的团队。这一项需要和对接的客户经理沟通确认细节，不是自助开关。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>订阅信息怎么导入客户端？</h3>\n              <p>一般是复制订阅链接，粘贴到客户端的订阅或配置导入栏里，客户端会自动拉取线路列表。也有客户端支持扫码导入。导入之后切换线路不需要重新操作。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>换了一台新设备，需要重新配置吗？</h3>\n              <p>需要在新设备上导入一次订阅，旧设备上的配置不会自动迁移。如果设备名额已经占满，先在旧设备上断开连接，再在新设备上连接即可。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>连不上时先排查什么？</h3>\n              <p>按顺序看三件事：剩余流量是否已经用完、同时在线设备是否达到上限、当前线路是否临时不可用。这三项都正常的话，换一条线路再试，通常就能恢复。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>支持哪些客户端？</h3>\n              <p>订阅本身不绑定特定客户端，Windows、macOS、iOS、Android 以及路由器上的常见工具都能读取。我们建议从客户端自身的官方发布页获取安装包，本页不提供下载地址。</p>\n            </div>\n            <div class=\"qa\">\n              <h3>付款和续费在哪里处理？</h3>\n              <p>本页只做方案说明，不承载下单和支付流程。续费与账单相关的问题，请通过你获得订阅时使用的渠道联系我们，我们会按实际情况答复。</p>\n            </div>\n          </div>\n        </section>\n\n        <footer class=\"foot\">\n          <div class=\"big\">有问题，<br>直接问<span>。</span></div>\n          <div class=\"meta\">\n            accecca · 网络工具与订阅方案<br>\n            本页内容如有调整，以最新说明为准<br>\n            <a href=\"#about\">回到开头</a>\n          </div>\n        </footer>\n      </main>\n    </div>\n  </div>\n</div>",
